<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>strido_bringup</name>
  <version>0.1.0</version>
  <description>Launch files, Gazebo world and udev rules for Strido (simulation and robot); the controller configuration lives in strido_description.</description>
  <maintainer email="noreply@example.com">Strido maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>strido_description</exec_depend>
  <exec_depend>strido_control</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>position_controllers</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>sllidar_ros2</exec_depend>
  <!-- camera_ros (robot.launch.py camera:=true) needs the Raspberry Pi libcamera fork; install it on the Pi, see docs/software.md -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
