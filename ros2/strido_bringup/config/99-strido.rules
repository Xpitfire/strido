# Strido stable device names (copy to /etc/udev/rules.d/)
# XIAO ESP32-S3 native USB CDC (Espressif VID 303a, Arduino USB-CDC-on-boot)
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", SYMLINK+="strido_mcu", MODE="0666"
# RPLIDAR C1 USB adapter (Silicon Labs CP210x)
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="rplidar", MODE="0666"
